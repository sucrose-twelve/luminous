NEXT_TELEMETRY_DISABLED=1

# App
NEXT_PUBLIC_APP_MODE=development
NEXT_PUBLIC_APP_NAME=project_name
NEXT_PUBLIC_APP_TZ=Asia/Singapore
NEXT_PUBLIC_APP_URL=https://localhost:8443

# Cipher (generate the secret: bun -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
CIPHER_ALGO=aes-256-gcm
CIPHER_SECRET=replace_with_at_least_32_random_characters
CIPHER_IV=12
CIPHER_SALT=16

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dbname
DB_USER=username
DB_PASSWORD=password
DB_TZ=Asia/Singapore

# Redis
REDIS_URL=redis://[username]:[password]@[host]:[port]
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=password
